<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>QIE Sentinel — Mission Control</title>
<style>
:root{color-scheme:dark;font-family:Inter,system-ui,Arial,sans-serif;background:#090e1b;color:#ebf1ff}*{box-sizing:border-box}body{margin:0}main{max-width:1150px;margin:auto;padding:36px 24px}header{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}h1{font-size:32px;letter-spacing:-1px;margin:0}h2{font-size:17px;margin:0 0 18px}small,.muted{color:#95a4c4}p{line-height:1.5}.logo{color:#a2ffcf}.pill{border:1px solid #315d66;border-radius:50px;padding:9px 13px;color:#a2ffcf;font-size:12px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:28px 0}.panel{background:#121c31;border:1px solid #273753;border-radius:18px;padding:22px}.metric{font-size:29px;font-weight:750;margin:14px 0 5px}.accent{color:#a2ffcf}.layout{display:grid;grid-template-columns:1fr 1fr;gap:16px}.label{display:block;color:#b7c7e4;font-size:12px;margin:16px 0 8px}input{width:100%;padding:13px;border:1px solid #35476c;border-radius:9px;background:#0a1327;color:#f1f5ff}button{background:#a2ffcf;border:0;border-radius:10px;padding:13px 18px;font-weight:750;cursor:pointer;margin-top:18px}button:disabled{opacity:.5}#feedback{margin-top:14px;white-space:pre-wrap;word-break:break-word}.item{border-top:1px solid #2a3955;padding:14px 0;word-wrap:break-word;font-size:13px}.status{font-weight:750}.good{color:#a2ffcf}.bad{color:#ff9fa6}.foot{margin-top:22px;font-size:12px;color:#95a4c4}a{color:#a2ffcf}code{font-size:12px;word-break:break-all}@media(max-width:850px){.grid{grid-template-columns:repeat(2,1fr)}.layout{grid-template-columns:1fr}}@media(max-width:500px){.grid{grid-template-columns:1fr}}
</style></head><body><main>
<header><div><div class="logo" style="font-weight:800;letter-spacing:3px;font-size:12px">◆ QIE SENTINEL</div><h1>Mission Control</h1><p class="muted">Live mainnet guardrails · Proposal-only agent sandbox</p></div><span class="pill" id="health">● Connecting to QIE</span></header>
<div class="grid"><div class="panel"><small>Vault balance</small><div class="metric" id="balance">—</div><small>QUSDC</small></div><div class="panel"><small>Available today</small><div class="metric" id="remaining">—</div><small>QUSDC</small></div><div class="panel"><small>Per-payment maximum</small><div class="metric" id="max">—</div><small>QUSDC</small></div><div class="panel"><small>Emergency status</small><div class="metric" id="pause">—</div><small id="block">Block —</small></div></div>
<div class="layout"><section class="panel"><h2>Agent payment proposal</h2><p class="muted">Check a payment against actual contract state. An eligible proposal is <b>not</b> a signed authorization or a transfer.</p><form id="form"><label class="label" for="recipient">Recipient address</label><input id="recipient" required value="0xce99cF8EdfD199dB02b830445d89E746B8c1C7ff"><label class="label" for="amount">Amount (QUSDC)</label><input id="amount" required type="number" min="0.000001" step="0.000001" value="0.25"><label class="label" for="purpose">Payment purpose</label><input id="purpose" required minlength="3" maxlength="180" value="Demo: approved AI service invoice"><button type="submit" id="submit">Evaluate live policy</button></form><div id="feedback"></div></section>
<section class="panel"><h2>Proposal decisions <small>(this session)</small></h2><div id="proposals" class="muted">No proposals yet.</div></section></div>
<section class="panel" style="margin-top:16px"><h2>Recent vault transfers <small>(last 3,000 blocks)</small></h2><div id="txs" class="muted">Scanning live chain…</div></section>
<div class="foot">QIE Sentinel does not store private keys or broadcast transfers. This is a prototype for demonstration, not an independently audited custody product. Chain reads refresh every 15 seconds. · <span id="error"></span></div>
</main><script>
const fmt=v=>(Number(v)/1e6).toFixed(6);
const esc=v=>String(v).replace(/[&<>"']/g,s=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[s]));
async function get(p){const r=await fetch(p,{cache:'no-store'});const j=await r.json();if(!r.ok)throw Error(j.detail||r.status);return j}
async function refresh(){try{const s=await get('/api/status');for(const [id,v] of [['balance',fmt(s.vault_balance)],['remaining',fmt(s.remaining_today)],['max',fmt(s.max_per_transfer)],['pause',s.paused?'PAUSED':'ACTIVE'],['block','Block '+s.block]])document.getElementById(id).textContent=v;document.getElementById('health').textContent='● QIE Mainnet · '+s.chain_id;document.getElementById('health').className='pill';document.getElementById('error').textContent='';}catch(e){document.getElementById('health').textContent='● RPC disconnected';document.getElementById('error').textContent=e.message}try{const d=await get('/api/proposals');document.getElementById('proposals').innerHTML=d.items.length?d.items.map(x=>`<div class="item"><span class="status ${x.decision==='BLOCKED'?'bad':'good'}">${esc(x.decision)}</span> · ${fmt(x.amount_base_units)} QUSDC<br><span class="muted">${esc(x.purpose)} · block ${x.block_checked}</span>${x.reasons.length?'<br>'+x.reasons.map(esc).join('; '):''}<br><small>Not submitted on-chain</small></div>`).join(''):'No proposals yet.'}catch(e){}try{const d=await get('/api/transactions');document.getElementById('txs').innerHTML=d.items.length?d.items.map(x=>`<div class="item">${fmt(x.amount_base_units)} QUSDC → ${esc(x.recipient)} · block ${x.block}<br><a href="https://mainnet.qie.digital/tx/${encodeURIComponent(x.hash)}" target="_blank" rel="noopener noreferrer">View transaction ↗</a></div>`).join(''):'No transfers in the most recent 3,000 blocks.'}catch(e){document.getElementById('txs').textContent='Transfer history unavailable: '+e.message}}
document.getElementById('form').addEventListener('submit',async e=>{e.preventDefault();const b=document.getElementById('submit');const box=document.getElementById('feedback');b.disabled=true;try{const amount=document.getElementById('amount').value;const [whole,fraction='']=amount.split('.');if(!/^\d+$/.test(whole)||!/^[0-9]{0,6}$/.test(fraction))throw Error('Amount must have at most 6 decimal places');const units=(BigInt(whole)*1000000n+BigInt(fraction.padEnd(6,'0')));if(units<=0n||units>1000000000000000000n)throw Error('Amount out of bounds');const r=await fetch('/api/proposals',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({recipient:document.getElementById('recipient').value,amount_base_units:Number(units),purpose:document.getElementById('purpose').value})});const data=await r.json();if(!r.ok)throw Error(data.detail||r.status);box.className=data.decision==='BLOCKED'?'bad':'good';box.textContent=data.decision+'\n'+(data.reasons.join('\n')||'Live read-only policy checks passed. Owner signature still required.');await refresh()}catch(err){box.className='bad';box.textContent=err.message}finally{b.disabled=false}});
refresh();setInterval(refresh,15000);
</script></body></html>
